{
  "name": "dnex-site",
  "version": "1.0.0",
  "private": true,
  "description": "DNex Business Setup — monorepo root. Manages frontend (Vite/React) and backend (Express mailer) workspaces.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start:backend": "npm run start --workspace=backend"
  }
}
