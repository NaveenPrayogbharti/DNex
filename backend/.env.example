# ─── Server ───────────────────────────────────────────────────────────────────
MAILER_PORT=3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your frontend origin (production URL in prod, localhost in dev)
ALLOWED_ORIGIN=http://localhost:5173

# ─── Mail Server (SMTP) ───────────────────────────────────────────────────────
MAIL_HOST=mail.yourdomain.com
